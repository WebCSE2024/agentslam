# ----------------------------------------------------------------------
# .env.example
# Copy this file to `.env`, fill in the values, and run:
# fly secrets import < .env
# ----------------------------------------------------------------------

# Database Connections
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
REDIS_URI=rediss://default:pass@redis-host:6379

# App Environment
NODE_ENV=developmen | production
PORT=5000
CORS_ORIGIN=https://your-frontend-domain.com
WS_URL=wss://your-fly-app.fly.dev/ws
WS_SANDBOX_URL=wss://your-fly-app.fly.dev/sandbox-ws
ORACLE_URL=http://localhost:8000


# JWT
JWT_SECRET=super_secret_jwt_key_here


# App Configuration
APP_JSON_LIMIT=16kb
APP_URLENCODED_LIMIT=16kb
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=1

# Auth / Session Config
SESSION_TTL_SECONDS=604800
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=7d
PASSKEY_TOKEN_TTL=24h
SANDBOX_TOKEN_TTL=45d

# Match - 15 minutes in milliseconds
MATCH_DURATION_MS=900000

# Socket and Sandbox Limits
SOCKET_MAX_MESSAGE_SIZE=7168
SOCKET_MAX_CHAT_MESSAGE_SIZE=3500
SOCKET_MESSAGE_LIMIT=5
SOCKET_WINDOW_TIME_SEC=120
SANDBOX_MSG_LIMIT=8
SANDBOX_MSG_WINDOW_SEC=600
SANDBOX_DURATION_MS=600000

# Emails
SMTP_HOST=your-smtp-host.com
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
EMAIL=from_email_address


# Additional Defaults
ONBOARDING_DEV_PASSWORD=your_secure_onboarding_password
ONBOARDING_PASSWORD_LENGTH=12
BCRYPT_SALT_ROUNDS=12
