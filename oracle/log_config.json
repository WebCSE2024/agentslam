{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s"
    }
  },
  "filters": {
    "healthcheck": {
      "()": "log_filter.HealthCheckFilter"
    }
  },
  "handlers": {
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "filters": ["healthcheck"]
    }
  },
  "loggers": {
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    }
  }
}
